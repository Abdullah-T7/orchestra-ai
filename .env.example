# ============================================================
# Orchestra AI — Environment Variables (Example / Template)
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values in .env
# 3. Never commit .env — it is gitignored
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=orchestra_db

# --- Backend ---
DATABASE_URL=postgresql://your_db_user:your_secure_password@postgres:5432/orchestra_db
REDIS_URL=redis://redis:6379

# --- Ollama (local LLM) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# --- Gemini API (optional — leave blank to use local Ollama only) ---
GEMINI_API_KEY=

# --- Frontend (exposed to browser, must start with NEXT_PUBLIC_) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/missions

